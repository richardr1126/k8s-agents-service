# Infrastructure only. Sign-up policy, guests, run limits, models and account
# email are admin settings: change them at /settings, or seed them below.

# Backend service
BACKEND_URL=http://localhost:8080
BACKEND_AUTH_TOKEN=

# Postgres for users, sessions, threads, run usage and settings (apply schema: pnpm db:migrate)
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/agents_ui

# Better Auth. Also encrypts the saved Resend API key, so keep it stable.
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# Public URL. Optional on Vercel, which falls back to the production domain.
BASE_URL=http://localhost:3000

# GitHub sign-in (optional; enabled only when both are set)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# First admin (optional; applied once per database). An existing account with
# this email becomes admin. Otherwise one is created with the password below
# (16+ characters), and gets admin rights after that password is changed.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/bootstrap-admin-password

# Starting admin settings (optional; see settings.example.json and settings.schema.json).
# Only unset keys are written, so changes made at /settings always win.
# RUNTIME_SEED_JSON={"version":1,"settings":{"signupPolicy":"approval"}}
# RUNTIME_SEED_JSON_PATH=./settings.json
