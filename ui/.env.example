# Backend service
BACKEND_URL=http://localhost:8080
BACKEND_AUTH_TOKEN=

# Postgres for users, sessions, threads and run usage (apply schema: pnpm db:migrate)
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/agents_ui

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_COOKIE_PREFIX=k8s-agents-auth

# GitHub sign-in (optional; enabled only when both are set)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Run limits (optional; 0 or less turns a window off)
RUN_LIMIT_GUEST_PER_MINUTE=2
RUN_LIMIT_GUEST_PER_DAY=3
RUN_LIMIT_USER_PER_MINUTE=5
RUN_LIMIT_USER_PER_DAY=15
RUN_LIMIT_EXEMPT_EMAILS=
